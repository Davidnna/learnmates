# Local development only. Generate a unique random secret; set the production value in the host dashboard.
SECRET_KEY=replace-with-a-long-random-secret
# Local SQLite by default. In production, set DATABASE_URL to your hosted PostgreSQL connection string.
DATABASE_URL=sqlite:///learning_assistant.db
COOKIE_SECURE=false
FLASK_DEBUG=false

# Choose one provider: groq (hosted), gemini, openai, or ollama.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback model; configure only after verifying access in Groq Console.
GROQ_FALLBACK_MODEL=
AI_TIMEOUT_SECONDS=60

# Optional legacy Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=

# Optional local Ollama settings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Optional OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
